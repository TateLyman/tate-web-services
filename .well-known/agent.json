  "name": "Tate Programs Agent Payment Surface Triage",
  "description": "A2A JSON-RPC endpoint for paid x402 launch triage, 402 Index health checks, and agent-skill trust checks.",
  "version": "2026.05.20",
  "provider": {
    "name": "Tate Programs",
